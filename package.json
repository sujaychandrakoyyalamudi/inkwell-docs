{
  "name": "inkwell-docs",
  "version": "1.0.0",
  "private": true,
  "description": "A small collaborative document editor: rich-text editing, file import, sharing, SQLite persistence.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"node --watch-path=server server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.js",
    "test": "node --test",
    "seed:reset": "node server/reset.js"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "mammoth": "^1.13.0",
    "marked": "^18.2.0",
    "multer": "^2.5.0",
    "sanitize-html": "^2.18.2"
  },
  "devDependencies": {
    "@tiptap/extension-text-align": "^3.34.0",
    "@tiptap/extensions": "^3.34.0",
    "@tiptap/pm": "^3.34.0",
    "@tiptap/react": "^3.34.0",
    "@tiptap/starter-kit": "^3.34.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "supertest": "^7.3.2",
    "vite": "^8.3.8"
  }
}
